{
  "expo": {
    "name": "Brotein",
    "slug": "brotein",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.brotein.app"
    },
    "android": {
      "package": "com.brotein.app"
    },
    "web": {
      "bundler": "metro"
    }
  }
}
